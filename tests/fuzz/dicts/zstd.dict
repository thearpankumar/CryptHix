# libFuzzer dictionary for the zstd frame targets (RFC 8878): magic numbers, frame header
# descriptors, window descriptors around the 1 MiB cap, block headers, and the 3-byte
# plain_len prefixes and inner-plaintext headers at the 1 MiB cap.
magic="\x28\xb5\x2f\xfd"
skippable_magic="\x50\x2a\x4d\x18"
fhd_single_fcs1="\x20"
fhd_single_fcs2="\x60"
fhd_single_fcs4="\xa0"
fhd_single_fcs8="\xe0"
fhd_windowed_fcs4="\x80"
fhd_no_fcs="\x00"
fhd_checksum="\x24"
fhd_dict_id="\x21"
fhd_reserved="\x28"
window_1mib="\x50"
window_over="\x51"
window_2mib="\x58"
block_raw_last_empty="\x01\x00\x00"
block_rle_last_128k="\x03\x00\x10"
block_compressed_last="\x05\x00\x00"
plain_len_1mib="\x10\x00\x00"
plain_len_over="\x10\x00\x01"
fcs4_1mib="\x00\x00\x10\x00"
inner_zstd="\x01\x00"
inner_payload_1mib="\x00\x10\x00\x00"
inner_payload_over="\x00\x10\x00\x01"
